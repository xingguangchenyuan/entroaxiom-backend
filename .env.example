# 本地开发用：复制为 .env 并修改。.env 绝不能提交到 Git。
APP_ENV=dev

# 随机长字符串（≥32）。生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# 用 python scripts/hash_password.py 生成。注意单引号：哈希里含 $，必须加引号
ADMIN_PASSWORD_HASH=''

DATABASE_URL=sqlite:///./data/entroaxiom.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# 本地 http 开发必须为 false（否则浏览器不会保存登录 Cookie）；生产必须为 true
COOKIE_SECURE=false
ENABLE_DOCS=true
# 开发时没有 Nginx，让后端自己提供 /uploads/public/*
SERVE_PUBLIC_UPLOADS=true
TRUST_PROXY=false
# 开发时前端 Vite 通过代理访问后端，同源，留空即可
ALLOWED_ORIGINS=
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
