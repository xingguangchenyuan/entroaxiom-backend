# ============ 基础 ============
NODE_ENV=development
# 只监听本机，外面由 Nginx 反代
HOST=127.0.0.1
PORT=8000

# 前台站点地址：cookie Secure 判断与 Origin/Referer 校验都以它为准，生产必须是 https；
# 它会被自动加入允许来源列表，不用在 ALLOWED_ORIGINS 里重复。
PUBLIC_ORIGIN=https://entroaxiom.com
# 额外的允许来源（逗号分隔）：后台在独立子域名时**必须**写进来，否则后台写请求会被 403
ALLOWED_ORIGINS=https://admin.entroaxiom.com

# ============ 数据库 ============
DATABASE_URL=postgres://entroaxiom:change-me@127.0.0.1:5432/entroaxiom
DATABASE_SSL=false
PG_POOL_MAX=10

# ============ 会话 ============
SESSION_COOKIE_NAME=sid
# 至少 32 字节随机串：openssl rand -base64 48
SESSION_SECRET=please-replace-with-32-bytes-of-random
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24

# Argon2id 每次哈希使用的内存（KiB），2C2G 机器建议 65536
PASSWORD_HASH_MEMORY_KIB=65536

# ============ 存储 ============
UPLOAD_ROOT=./var/uploads
IMPORT_ROOT=./var/imports
BACKUP_ROOT=./var/backups
# 仅用于后台仪表盘的容量展示，留空则不显示
STORAGE_TOTAL_BYTES=

# ============ 限额 ============
MAX_BODY_BYTES=2097152
MAX_FILE_BYTES=52428800
MAX_ARCHIVE_BYTES=41943040
MAX_EXPANDED_BYTES=209715200
MAX_ARCHIVE_ENTRIES=2000
IMPORT_TIMEOUT_MS=60000
IMPORT_TTL_MINUTES=30
MAX_CONCURRENT_UPLOADS=3
VERSION_RETENTION=20
SHORT_BODY_CHARS=50
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif,avif,pdf,zip,md,txt,doc,docx
# 注意：SVG 已在业务层强制拒绝（即使写进上面这一行也会被拒），详见 README「安全边界」

# ============ 安全 ============
# 用来对留言 IP 做 HMAC，至少 16 字节随机串；换掉它等于让历史 ip_hash 失去可比性
IP_HASH_SECRET=please-replace-with-random
MODERATION_POLICY_VERSION=2026-11-01

# ============ 其它 ============
LOG_LEVEL=info
# 是否信任反代传来的 X-Forwarded-For / X-Forwarded-Proto。
# 代码默认 false：直连 Node 时客户端可以随便伪造这些头，留言/登录限流
# 就会按伪造的 IP 计数。只有 Node 只监听 127.0.0.1、前面确实是本机 Nginx
# 时才设 true。
TRUST_PROXY=true



