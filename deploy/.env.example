# 生产用：复制为 deploy/.env（chmod 600），绝不提交到 Git。

# 容器内进程使用的用户（与宿主机上 data/ uploads/ 目录的属主一致）：id -u / id -g 查看
APP_UID=1000
APP_GID=1000

# 前端构建产物目录（npm run build 生成的 dist），相对 deploy/ 或绝对路径
FRONTEND_DIST=../../entroaxiom-site/dist

APP_ENV=prod
SECRET_KEY=
# 单引号必须保留
ADMIN_PASSWORD_HASH=''

DATABASE_URL=sqlite:////app/data/entroaxiom.db
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=50

COOKIE_SECURE=true
ENABLE_DOCS=false
SERVE_PUBLIC_UPLOADS=false
TRUST_PROXY=true
# 你的站点地址，如 https://example.com （写操作只接受来自这里的请求）
ALLOWED_ORIGINS=
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
